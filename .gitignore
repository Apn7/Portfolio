# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent specific
CLAUDE.md
AGENTS.md

# theme tooling — local-only build deps (not part of the deployed app)
/scripts/theme/node_modules


# LaTeX build artifacts
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.build.log
texput.log

# Ignore all files in assets/docs except Ekramul_Alam_Resume.tex and Ekramul_Alam_Resume.pdf
assets/docs/*
!assets/docs/Ekramul_Alam_Resume.tex
!assets/docs/Ekramul_Alam_Resume.pdf

# Ignore all files in public/assets/docs except Ekramul_Alam_Resume.pdf
public/assets/docs/*
!public/assets/docs/Ekramul_Alam_Resume.pdf

# Confidential — personal project reference, do NOT push
project_context.md
